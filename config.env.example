# ==============================================================================
# DHCPLAB (dhcplab) - ENVIRONMENT CONFIGURATION
# Standard: DHCPv4, DHCPv6, SLAAC, DHCP Relay Conformance Test Lab
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Topology & Execution Mode
# ------------------------------------------------------------------------------
# TOPOLOGY_MODE:
#   'virtual'  : Full software simulation using isolated Linux netns (ns-wan, ns-dut, ns-pc, ns-stb, ns-wlan*)
#   'physical' : Physical testbed using dedicated NICs connected to external hardware DUT
TOPOLOGY_MODE="virtual"
LAB_ROLE="single"
IP_VERSION="dual"

# ------------------------------------------------------------------------------
# 2. Physical Adapters (Used when TOPOLOGY_MODE="virtual")
# ------------------------------------------------------------------------------
# In Physical mode, connect PC test NICs to physical DUT ports:
#   WAN_IF : Connects to DUT WAN port (e.g. eth0)
#   LAN_IF / PC_IF : Connects to DUT 1G LAN PC port (e.g. eth3)
#   STB_IF : Connects to DUT 100M IPTV STB port (e.g. eth1)
WAN_IF="enx6c1ff76608e2"
LAN_IF="enxd46e0e0c66e7"
PC_IF="enxd46e0e0c66e7"
STB_IF=""

# ------------------------------------------------------------------------------
# 2.1 Wireless Adapters & Adaptive Test Mode Configuration
# ------------------------------------------------------------------------------
# WIFI_TEST_MODE:
#   'auto'             : Auto-detects physical Wi-Fi NICs via 'wifi_inspector.py':
#                        - 0 cards : Fallback to 'emulated' (Virtual Netns)
#                        - 1 card  : 'real_single_band' (Wired 1G + Real Over-The-Air Wi-Fi)
#                        - 3+ cards: 'physical' (Full Multi-Station Over-The-Air) [Default]
#   'real_single_band' : Measures Wired LAN (B) + Real Active Wi-Fi (A) Over-The-Air (OTA)
#                        using the single available physical card to genuinely stress DUT RF chip!
#   'hybrid'           : Real OTA for the active band (e.g. 5GHz) + virtual netns for 2.4G & 6G.
#   'sequential'       : Sequentially tests each supported band (2.4G -> 5G -> 6G) on 1 card.
#   'emulated'         : Pure software netns simulation (ns-wlan2g, ns-wlan5g, ns-wlan6g).
WIFI_TEST_MODE="auto"

# Physical Wi-Fi Interface:
# Set to 'auto' to auto-detect from system, or specify interface name (e.g. "wlp45s0f0"):
PHYSICAL_WIFI_IF="auto"

# Supported Frequency Bands for the card (comma-separated, or 'auto' to probe via iw phy):
PHYSICAL_WIFI_SUPPORTED_BANDS="auto"

# Active Band currently connected / targeted for benchmark ("2.4G", "5G", "6G", or "auto"):
PHYSICAL_WIFI_ACTIVE_BAND="auto"

# Target DUT Wireless SSIDs & Credentials per Band
DUT_SSID_2G="DUT_2.4G"
DUT_PASS_2G=""
DUT_SSID_5G="DUT_5G"
DUT_PASS_5G=""
DUT_SSID_6G="DUT_6G"
DUT_PASS_6G=""

# Baseline Wi-Fi Network (Optional: office/lab Wi-Fi to restore after testing)
BASELINE_WIFI_SSID=""

# ------------------------------------------------------------------------------
# 2.2 Remote PC Client Configuration (Optional Distributed Multi-Station Testing)
# ------------------------------------------------------------------------------
# Set REMOTE_CLIENT_ENABLED="1" to enable distributed testing with a secondary PC:
REMOTE_CLIENT_ENABLED="1"

# Remote PC Network & SSH Credentials:
REMOTE_CLIENT_HOST="192.168.100.84"             # IP address or hostname of secondary test PC (e.g. "192.168.100.87" or "192.168.1.150")
REMOTE_CLIENT_USER="network"      # SSH username on remote PC
REMOTE_CLIENT_PORT="22"           # SSH port
REMOTE_CLIENT_KEY="~/.ssh/id_ed25519"              # Path to SSH key (private key or .pub path; expanded automatically under sudo)
REMOTE_CLIENT_PUBLIC_KEY="~/.ssh/id_ed25519.pub"   # Public key path (optional alias, auto-resolves private key counterpart)
REMOTE_CLIENT_DIR="/home/network/workspace/dhcplab"              # Absolute path to lab directory on remote PC (defaults to local lab path)
REMOTE_CLIENT_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"

# Remote Client Role & Interfaces:
#   'wifi_client' : Remote PC acts as wireless station (2.4G or 5G OTA)
#   'lan_client'  : Remote PC acts as secondary 1G/2.5G wired client
REMOTE_CLIENT_ROLE="wifi_client"
REMOTE_CLIENT_WIFI_IF="auto"      # Remote Wi-Fi interface name or 'auto'

# Optional dedicated multi-adapter mapping (used when multiple physical Wi-Fi NICs exist)
WLAN2G_IF=""
WLAN5G_IF=""
WLAN6G_IF=""
PHONE1_IF=""
PHONE2_IF=""

# Optional 802.1Q VLAN Trunk Mode (when using managed switch trunk port connected to 1 PC NIC)
# If configured, sub-interfaces are automatically created (e.g. ${VLAN_TRUNK_IF}.10 for PC, .20 for STB)
VLAN_TRUNK_IF=""
VLAN_ID_PC="10"
VLAN_ID_STB="20"
VLAN_ID_WLAN2G="31"
VLAN_ID_WLAN5G="32"
VLAN_ID_WLAN6G="33"

RESTORE_INTERFACES_ON_CLEANUP="1"

# ------------------------------------------------------------------------------
# 2.3 Device Under Test (DUT) Management & Artifact Collection
# ------------------------------------------------------------------------------
# Set to '1' to enable automated DUT diagnostic artifact collection:
DUT_COLLECTOR_ENABLED="1"
DUT_SSH_HOST="192.168.1.1"          # DUT IP address or hostname (defaults to DUT_LAN_IP)
DUT_SSH_USER="root"                 # SSH username on DUT (default: root)
DUT_SSH_PORT="22"                   # SSH port on DUT (default: 22)
DUT_SSH_KEY=""                      # Path to SSH private key for DUT authentication
DUT_SSH_PASS=""                     # SSH password for DUT (used with sshpass if key not set)
DUT_SSH_OPTS="-o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"

# ------------------------------------------------------------------------------
# 3. Network Namespace Names
# ------------------------------------------------------------------------------
WAN_NS="ns-wan"
DUT_NS="ns-dut"
PC_NS="ns-pc"
STB_NS="ns-stb"
WLAN2G_NS="ns-wlan2g"
WLAN5G_NS="ns-wlan5g"
WLAN6G_NS="ns-wlan6g"
PHONE1_NS="ns-phone1"
PHONE2_NS="ns-phone2"

# ------------------------------------------------------------------------------
# 4. Upstream WAN Network Parameters (IPv4 & IPv6 Gateway)
# ------------------------------------------------------------------------------
WAN_BRIDGE="br-test-wan"
WAN_SERVER_IP="10.10.0.1"
DUT_WAN_IP="10.10.0.100"
WAN_PREFIX="24"
WAN_GATEWAY="10.10.0.1"
WAN_IPV4_SUBNET="10.10.0.0/24"
WAN_IPV4_POOL_START="10.10.0.100"
WAN_IPV4_POOL_END="10.10.0.200"
WAN_IPV4_ROUTER="10.10.0.1"
WAN_IPV4_DNS="10.10.0.1"
WAN_IPV4_DNS2="10.10.0.2"

WAN_IPV6_CIDR="2001:db8:10::1/64"
WAN_IPV6_PREFIX="2001:db8:10::/64"
WAN_IPV6_DNS="2001:db8:10::1"
WAN_IPV6_DNS2="2001:db8:10::2"
DUT_WAN_IPV6="2001:db8:10::1000/64"

# Prefix Delegation (DHCPv6-PD - RFC 3633 / RFC 8415)
PD_PREFIX="2001:db8:100::"
PD_PREFIX_LEN="56"
PD_DELEGATED_LEN="60"

# Optional 802.1Q VLAN Tagging (empty when using transparent Linux Bridge)
WAN_VLAN_ID=""

# Enable WAN DHCP Server in ns-wan (Automatically leases IP to DUT WAN)
WAN_DHCP_ENABLE="1"
WAN_DHCP_BACKEND="auto"           # Options: "auto" (Kea with dnsmasq fallback), "kea", "dnsmasq"
WAN_DHCP_RANGE_START="10.10.0.100"
WAN_DHCP_RANGE_END="10.10.0.200"

# ------------------------------------------------------------------------------
# 5. LAN Network & Client Subnets
# ------------------------------------------------------------------------------
DUT_LAN_IP="192.168.1.1"
DUT_LAN_IPV6="2001:db8:100::1"
LAN_PREFIX="24"

# Enable dynamic DHCP client on LAN endpoints (leases IP from DUT LAN br0)
# Default is "1" in --single mode to automatically acquire IPv4 & IPv6 from DUT
LAN_DHCP_CLIENT="1"

# Client IP Assignments
PC_IP="192.168.1.10"
STB_IP="192.168.1.20"
WLAN2G_IP="192.168.1.31"
WLAN5G_IP="192.168.1.32"
WLAN6G_IP="192.168.1.33"
PHONE1_IP="192.168.1.41"
PHONE2_IP="192.168.1.42"

# ------------------------------------------------------------------------------
# 5.1 DUT LAN DHCPv4 & DHCPv6 Server Configuration (Home Gateway Service)
# ------------------------------------------------------------------------------
# In Virtual Mode (--virtual), these parameters govern the simulated Gateway DHCP daemons.
# In Physical Mode (--single), these define the expected DUT configuration & test assertions.
DUT_DHCPV4_SERVER_ENABLE="1"
DUT_DHCPV4_POOL_START="192.168.1.100"
DUT_DHCPV4_POOL_END="192.168.1.200"
DUT_DHCPV4_LEASE_TIME="7200"
DUT_DHCPV4_ROUTER="192.168.1.1"
DUT_DHCPV4_DNS="192.168.1.1, 8.8.8.8"
DUT_DHCPV4_DOMAIN="home.gateway"

# Static DHCP Reservation (MAC to IP binding)
DUT_DHCPV4_STATIC_MAC="02:00:00:00:01:99"
DUT_DHCPV4_STATIC_IP="192.168.1.99"
DUT_DHCPV4_STATIC_HOSTNAME="reserved-test-host"

# DUT LAN DHCPv6 Server & RA
DUT_DHCPV6_SERVER_ENABLE="1"
DUT_DHCPV6_MODE="stateless"          # Options: "stateless" (SLAAC+O flag), "stateful" (M flag+IA_NA)
DUT_DHCPV6_POOL_START="2001:db8:100:1::1000"
DUT_DHCPV6_POOL_END="2001:db8:100:1::2000"
DUT_DHCPV6_LEASE_TIME="3600"

# ------------------------------------------------------------------------------
# 5.2 DUT DHCP Relay Configuration (RFC 3046 Option 82 & RFC 8415 Relay)
# ------------------------------------------------------------------------------
# Configures the Gateway to forward DHCP requests from LAN to Upstream WAN Server
DHCP_RELAY_ENABLE="0"
DHCP_RELAY_SERVER_V4="10.10.0.1"
DHCP_RELAY_SERVER_V6="2001:db8:10::1"
DHCP_RELAY_OPT82_CIRCUIT_ID="eth-lan"
DHCP_RELAY_OPT82_REMOTE_ID="gw-home-01"
DHCP_RELAY_INTERFACE_ID="br-lan"

# ------------------------------------------------------------------------------
# 5.3 DHCP Test Acceptance Criteria & Timeouts
# ------------------------------------------------------------------------------
DHCP_HANDSHAKE_TIMEOUT_SEC="10"
DHCP_RENEWAL_TIMEOUT_SEC="10"
DHCP_RELEASE_TIMEOUT_SEC="5"


# ------------------------------------------------------------------------------
# 6. Rate Mismatch & Burst Emulation (1 Gbps WAN -> 100 Mbps LAN STB)
# ------------------------------------------------------------------------------
# Gateway Uplink & Wired PC Port (1 Gbps Giga Gateway)
WAN_RATE_LIMIT="1000mbit"
WAN_BURST_BUFFER="512kb"
PC_RATE_LIMIT="1000mbit"
PC_BURST_BUFFER="512kb"

# Simulated 100BASE-TX Fast Ethernet link bottleneck
STB_RATE_LIMIT="100mbit"
STB_QUEUE_BURST_BUFFER="512kb"
STB_QUEUE_LIMIT="4mb"

# Burst Test Case 1: 1500B packets, Burst Load 50%, Burst Length >= 53 frames
BURST_CASE1_FRAMES="53"
BURST_CASE1_LOAD="50.0"

# Burst Test Case 2: 1500B packets, Burst Length 100 frames, Burst Load >= 16%
BURST_CASE2_FRAMES="100"
BURST_CASE2_LOAD="16.0"

BURST_PACKET_SIZE="1500"
BURST_COUNT="20"

# ------------------------------------------------------------------------------
# 7. Wire-Rate & QoS Verification Thresholds
# ------------------------------------------------------------------------------
# Wire-Rate 1024B Unicast Engine:
#   'auto'   : Prefer iperf3 (C-based kernel performance) if installed, fallback to Python
#   'iperf3' : Use iperf3 -u -b 1000M -l 982 for maximum wire-rate accuracy (>116,000 PPS)
#   'python' : Use native zero-allocation Python traffic_generator.py
WIRE_RATE_ENGINE="auto"

UNICAST_PACKET_SIZE="1024"
UNICAST_TARGET_RATE="950M"
UNICAST_MODE="sequential"
UNICAST_OMIT_SEC="2"
UNICAST_SOCKET_BUFFER="4M"
UNICAST_FORWARD_PORT="5002"
UNICAST_REVERSE_PORT="5012"
MULTICAST_PACKET_SIZE="1024"
MULTICAST_GROUP="239.255.0.1"

# Maximum allowable performance degradation (Percentage)
THROUGHPUT_DROP_TOLERANCE_PCT="1.0"
VOIP_IMPACT_TOLERANCE_PCT="1.0"

# VoIP QoS (TC-QOS-01) Parameters:
#   'auto'   : Prefer PJSIP (tools/bin/pjsua), then SIPp (/usr/bin/sipp), fallback to Python
#   'pjsua'  : Use PJSIP pjsua CLI with --set-qos (DSCP EF / WMM AC_VO)
#   'sipp'   : Use SIPp standard UAS/UAC engine
#   'python' : Use native zero-dependency voip_call_simulator.py
VOIP_ENGINE="auto"
VOIP_CALL_COUNT="2"
VOIP_CALL_DURATION_SEC="20"

# Cloud Gaming (GeForce NOW) Acceptance Criteria
# Standard Tier (60 FPS / 25 Mbps):
GEFORCE_NOW_FPS="60"
GEFORCE_NOW_BITRATE_MBPS="25.0"
GEFORCE_NOW_MAX_JITTER_MS="2.0"
GEFORCE_NOW_MAX_LOSS_PCT="0.0"

# Competitive Esports Tier (120 FPS / 50 Mbps) Defaults:
GEFORCE_NOW_120FPS_BITRATE_MBPS="50.0"
GEFORCE_NOW_120FPS_MAX_JITTER_MS="1.5"

# UHD+Dolby 1.2x VOD Parameters
VOD_BASE_BITRATE_MBPS="35.0"
VOD_SPEED_MULTIPLIER="1.2"

# Benchmark Parameters
BENCHMARK_TRIALS="5"
BENCHMARK_DURATION_SEC="5"

# ------------------------------------------------------------------------------
# 8. Runtime Storage & Binaries
# ------------------------------------------------------------------------------
CAPTURE_DIR="captures"
LOG_DIR="logs"
STATE_DIR="state"
TCPDUMP_BIN="tcpdump"
TSHARK_BIN="tshark"
PYTHON_BIN="python3"
IPERF3_BIN="iperf3"
CAPTURE_FILTER="udp or tcp or icmp or arp"

# CAPTURE_SNAPLEN:
#   Snaplen (bytes of packet payload to capture per frame).
#   '0'   : Full packet payload capture (essential for DHCP/DHCPv6 option inspection).
#   '96'  : Extended protocol headers.
CAPTURE_SNAPLEN="0"

# ------------------------------------------------------------------------------
# 9. Logging Format & Timestamps
# ------------------------------------------------------------------------------
# LOG_TIME_ENABLE:
#   '1' : Prepend timestamp to log messages ([YYYY-MM-DD HH:MM:SS]) [Default]
#   '0' : Disable timestamp prefix in logs
LOG_TIME_ENABLE="1"

# LOG_TIME_FORMAT:
#   Custom timestamp format string (e.g. "%Y-%m-%d %H:%M:%S" or "%H:%M:%S")
LOG_TIME_FORMAT="%Y-%m-%d %H:%M:%S"

