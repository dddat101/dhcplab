#!/bin/sh
# ==============================================================================
# Namespace-Safe udhcpc event script
# Binds IP and default route inside netns without touching host /etc/resolv.conf
# ==============================================================================
set -eu

case "${1:-}" in
    bound|renew)
        [ -n "${ip:-}" ] || exit 0

        # Calculate CIDR mask (BusyBox udhcpc provides $mask or $subnet)
        cidr="${mask:-${prefix:-}}"
        if [ -z "${cidr}" ] && [ -n "${subnet:-}" ]; then
            case "${subnet}" in
                255.255.255.255) cidr="32" ;;
                255.255.255.0)   cidr="24" ;;
                255.255.0.0)     cidr="16" ;;
                255.0.0.0)       cidr="8" ;;
                *)               cidr="24" ;;
            esac
        fi
        [ -z "${cidr}" ] && cidr="24"

        ip -4 addr flush dev "${interface}" 2>/dev/null || true
        ip -4 addr add "${ip}/${cidr}" dev "${interface}" 2>/dev/null || true
        if [ -n "${router:-}" ]; then
            ip -4 route replace default via "${router%% *}" dev "${interface}" 2>/dev/null || true
        fi
        ;;
    deconfig)
        ip -4 addr flush dev "${interface}" 2>/dev/null || true
        ;;
esac
