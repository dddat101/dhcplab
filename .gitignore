# Local environment configuration
config.env
!config.env.example

# Runtime state and generated artifacts
state/*
!state/.gitkeep
logs/*
!logs/.gitkeep
!logs/raw_iperf/
logs/raw_iperf/*
!logs/raw_iperf/.gitkeep
artifacts/*
!artifacts/.gitkeep
*.pid
*.log
*.remote
*.leases

# Packet captures
captures/*
!captures/.gitkeep
*.pcap
*.pcapng
!templates/*.pcap

# Python Virtualenv & Cache
.venv/
__pycache__/
*.pyc

# Editor & OS files
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Compiled tools & binaries
tools/bin/*
!tools/bin/.gitkeep
tools/lib/*
!tools/lib/.gitkeep
pcap/
